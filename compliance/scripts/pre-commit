#!/bin/bash
# AILOS Pre-commit Hook
# 提交前自动执行合规检测，一级违规项拦截提交

echo "============================================"
echo "AILOS 合规检测 - Pre-commit Hook"
echo "============================================"

python compliance/scripts/compliance_check.py --path . --level 1

if [ $? -ne 0 ]; then
    echo ""
    echo "!!! 提交被拦截：存在一级违规项 !!!"
    echo "请修复所有一级违规后重新提交"
    exit 1
fi

echo "合规检测通过，允许提交"
exit 0
