SYSTEM_DB_PORT=3306
SYSTEM_DB_NAME=system_db
SYSTEM_DB_USER=ailos_system_svc
SYSTEM_DB_PASSWORD=CHANGE_ME_SYSTEM_PWD

# === Redis 配置 ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === RabbitMQ 配置 ===
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# === 腾讯混元 API 预留位（密钥通过独立加密环境变量注入） ===
# 禁止在此处或任何配置文件中填写真实密钥
# 部署时通过加密环境变量注入
HUNYUAN_API_KEY=
HUNYUAN_API_ENDPOINT=
HUNYUAN_LIGHTWEIGHT_MODEL=
HUNYUAN_STANDARD_MODEL=

# === JWT 配置 ===
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=7d

# === 日志配置 ===
LOG_LEVEL=debug
LOG_RETENTION_DAYS=1095
