# === 应用配置 ===
NODE_ENV=development
APP_PORT=3000
APP_NAME=AILOS

# === 数据库配置（七库独立账号） ===
# 用户核心库
USER_DB_HOST=localhost
USER_DB_PORT=3306
USER_DB_NAME=user_db
USER_DB_USER=ailos_user_svc
USER_DB_PASSWORD=CHANGE_ME_USER_PWD

# 学习业务库
LEARNING_DB_HOST=localhost
LEARNING_DB_PORT=3306
LEARNING_DB_NAME=learning_db
LEARNING_DB_USER=ailos_learning_svc
LEARNING_DB_PASSWORD=CHANGE_ME_LEARNING_PWD

# AI记忆与陪伴库
COMPANION_DB_HOST=localhost
COMPANION_DB_PORT=3306
COMPANION_DB_NAME=companion_db
COMPANION_DB_USER=ailos_companion_svc
COMPANION_DB_PASSWORD=CHANGE_ME_COMPANION_PWD

# 知识资产库
KNOWLEDGE_DB_HOST=localhost
KNOWLEDGE_DB_PORT=3306
KNOWLEDGE_DB_NAME=knowledge_db
KNOWLEDGE_DB_USER=ailos_knowledge_svc
KNOWLEDGE_DB_PASSWORD=CHANGE_ME_KNOWLEDGE_PWD

# 社交库
SOCIAL_DB_HOST=localhost
SOCIAL_DB_PORT=3306
SOCIAL_DB_NAME=social_db
SOCIAL_DB_USER=ailos_social_svc
SOCIAL_DB_PASSWORD=CHANGE_ME_SOCIAL_PWD

# 权益营销库
MARKETING_DB_HOST=localhost
