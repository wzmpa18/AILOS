# AILOS 环境变量配置
# 复制此文件为 .env 并修改配置

NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=ailos-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# 数据库 (MySQL)
DATABASE_URL=mysql://root:password@localhost:3306/ailos

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 短信 (阿里云/腾讯云)
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=AILOS
SMS_TEMPLATE_CODE=

# 微信
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# AI
AI_PROVIDER=hunyuan
AI_API_KEY=
AI_API_ENDPOINT=
AI_MODEL=hunyuan-lite

# CORS
CORS_ORIGIN=http://localhost:5173

# 速率限制
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100