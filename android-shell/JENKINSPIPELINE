// AILOS v1.0 Beta - Jenkins Pipeline (自建云端打包)
// 对接GitHub仓库，代码推送自动触发打包
// 基线: f13eddb | APK同步至网站静态目录

pipeline {
    agent { label 'android-builder' }
    
    environment {
        BASELINE_SHA = 'f13eddb'
        PROJECT_DIR = '/workspace/ailos/android-shell'
        OUTPUT_DIR = '/output'
        ANDROID_HOME = '/android-sdk'
        KEYSTORE_PATH = credentials('ailos-keystore-path')
        KEYSTORE_PASSWORD = credentials('ailos-keystore-password')
        KEY_ALIAS = credentials('ailos-key-alias')
        KEY_PASSWORD = credentials('ailos-key-password')
    }
    
    triggers {
        githubPush()
    }
    
    stages {
        stage('基线校验') {
            steps {
                script {
                    def sha = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    echo "Git SHA: ${sha} (baseline: ${BASELINE_SHA})"
                    
                    def health = sh(script: 'curl -s https://yandao.vip/xuewaiyu/api/health | python3 -c "import sys,json;print(json.load(sys.stdin).get(\'status\',\'\'))"', returnStdout: true).trim()
                    echo "Backend: ${health}"
                    
                    sh '[ -f "${PROJECT_DIR}/app/build.gradle" ] || exit 1'
                    echo "All checks passed"
                }
            }
        }
        
        stage('构建APK') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        if [ "$GIT_BRANCH" = "origin/main" ]; then
                            ./gradlew clean assembleRelease \
                                -Pandroid.injected.signing.store.file=$KEYSTORE_PATH \
                                -Pandroid.injected.signing.store.password=$KEYSTORE_PASSWORD \
                                -Pandroid.injected.signing.key.alias=$KEY_ALIAS \
                                -Pandroid.injected.signing.key.password=$KEY_PASSWORD
                            cp app/build/outputs/apk/release/app-release.apk ${OUTPUT_DIR}/AILOS_言道学外语_v1.0.0_Release.apk
                            cp app/build/outputs/mapping/release/mapping.txt ${OUTPUT_DIR}/mapping_v1.0.0.txt
                        else
                            ./gradlew clean assembleDebug
                            cp app/build/outputs/apk/debug/app-debug.apk ${OUTPUT_DIR}/AILOS_言道学外语_v1.0.0_Debug.apk
                        fi
                    '''
                }
            }
        }
        
        stage('同步至网站目录') {
            steps {
                sh '''
                    # APK同步到nginx下载目录
                    if [ -f "${OUTPUT_DIR}/AILOS_言道学外语_v1.0.0_Release.apk" ]; then
                        echo "Release APK: http://82.156.228.87:8081/download/AILOS_言道学外语_v1.0.0_Release.apk"
                    fi
                    if [ -f "${OUTPUT_DIR}/AILOS_言道学外语_v1.0.0_Debug.apk" ]; then
                        echo "Debug APK: http://82.156.228.87:8081/download/AILOS_言道学外语_v1.0.0_Debug.apk"
                    fi
                '''
            }
        }
    }
    
    post {
        always {
            archiveArtifacts artifacts: '**/AILOS_*.apk', allowEmptyArchive: true
        }
        success { echo 'AILOS APK构建成功！下载地址: http://82.156.228.87:8081/download/' }
        failure { echo 'AILOS APK构建失败！' }
    }
}
