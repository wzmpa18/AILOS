<?xml version="1.0" encoding="UTF-8"?>
<!--
  AILOS v1.0 Beta - APICloud云端打包配置
  轻量化零环境，适合快速内测
  基线: f13eddb | 网页后台一键打包 | 无需本地SDK
-->
<widget id="ai.yandao.ailos" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>AILOS言道学外语</name>
    <description>言道智能学外语平台 - AI驱动的语言学习应用</description>
    <author email="dev@yandao.ai" href="https://yandao.vip">AILOS Team</author>
    
    <!-- 内容源：H5线上站点 -->
    <content src="https://yandao.vip/xuewaiyu/index.html" />
    
    <!-- 允许访问的域名 -->
    <access origin="https://yandao.vip" />
    <access origin="https://api.yandao.vip" />
    
    <!-- 禁止混合内容 -->
    <access origin="http://*" subdomains="true" launch-external="yes" />
    
    <!-- 偏好设置 -->
    <preference name="appVersion" value="1.0.0" />
    <preference name="appBuildNumber" value="1" />
    <preference name="windowBackground" value="#667eea" />
    <preference name="urlScheme" value="ailos" />
    <preference name="backgroundColor" value="#ffffff" />
    <preference name="fullScreen" value="true" />
    <preference name="statusBarAppearance" value="false" />
    <preference name="splashScreen" value="true" />
    <preference name="autoHideSplashScreen" value="true" />
    <preference name="splashScreenDelay" value="1500" />
    <preference name="showLoading" value="false" />
    <preference name="loadingImage" value="" />
    <preference name="cacheMode" value="default" />
    <preference name="keyboardType" value="normal" />
    <preference name="softInputMode" value="resize" />
    <preference name="hardwareAccelerated" value="true" />
    <preference name="debug" value="false" />
    <preference name="webStorage" value="true" />
    <preference name="database" value="true" />
    <preference name="allowFileAccess" value="false" />
    
    <!-- 安卓专属配置 -->
    <preference name="android-minSdkVersion" value="26" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="android-signType" value="release" />
    <preference name="android-compileSdkVersion" value="34" />
    <preference name="android-buildToolsVersion" value="34.0.0" />
    
    <!-- 权限配置 -->
    <feature name="camera">
        <param name="android_permission" value="android.permission.CAMERA" />
    </feature>
    <feature name="fileTransfer">
        <param name="android_permission" value="android.permission.READ_EXTERNAL_STORAGE" />
        <param name="android_permission" value="android.permission.READ_MEDIA_IMAGES" />
    </feature>
    <feature name="network">
        <param name="android_permission" value="android.permission.INTERNET" />
        <param name="android_permission" value="android.permission.ACCESS_NETWORK_STATE" />
    </feature>
    
    <!-- 预置权限说明（合规要求） -->
    <permission name="camera" description="用于拍照翻译和扫描翻译功能" />
    <permission name="storage" description="用于保存学习记录和翻译历史" />
    <permission name="network" description="用于加载学习内容和AI对话" />
    
    <!-- 启动图标 -->
    <icon src="icon/android/icon.png" platform="android" width="144" height="144" />
    <icon src="icon/android/icon-72.png" platform="android" width="72" height="72" />
    <icon src="icon/android/icon-96.png" platform="android" width="96" height="96" />
    <icon src="icon/android/icon-48.png" platform="android" width="48" height="48" />
    
    <!-- 启动图 -->
    <splash src="splash/android/splash.png" platform="android" density="hdpi" />
    <splash src="splash/android/splash-land.png" platform="android" density="land-hdpi" />
    
    <!-- 自定义签名（通过APICloud后台上传证书） -->
    <!--
    签名配置说明：
    1. 在APICloud后台「证书管理」中上传.a keystore文件
    2. 填写keystore密码、key别名、key密码
    3. 构建时选择「自定义签名」
    4. 系统自动使用上传的证书签名
    -->
</widget>
