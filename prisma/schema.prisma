  classId String
  class   OrgClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation("OrgClassStudentUser", fields: [userId], references: [id], onDelete: Cascade)
  status  String   @default("active") // active, left

