  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([account])
  @@index([createdAt])
}

// ==================== Phase 4 P2: Organization B-end (机构端) — 纯增量模型 ====================

// org_class — 机构班级（新增表，零修改已有模型）
model OrgClass {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  teacherId      String?
  teacher        User?        @relation("OrgClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  status         String       @default("active") // active, archived
  studentCount   Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students OrgClassStudent[]

  @@index([organizationId])
  @@index([teacherId])
  @@index([status])
}

// org_class_student — 班级学生关联（新增表，零修改已有模型）
model OrgClassStudent {
