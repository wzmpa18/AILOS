  name         String
  level        Int      @default(0)
  price        Int      @default(0)                      // 整数分单位
  durationDays Int      @default(30)
  description  String   @default("")
  features     Json     @default("[]")
  status       String   @default("active")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userMemberships UserMembership[]

  @@index([status])
  @@index([level])
  @@map("membership_plans")
}

/// 用户会员表（记录开通历史，独立于User字段）
model UserMembership {
  id           String   @id @default(uuid())
  userId       String
  planId       String?
  planCode     String
  level        Int      @default(0)
  startTime    DateTime
  endTime      DateTime
  status       String   @default("active")
  source       String   @default("direct")               // direct/proxy/gift
  orderId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User?    @relation("UserMemberships", fields: [userId], references: [id], onDelete: SetNull)
  plan         MembershipPlan? @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([endTime])
  @@index([source])
  @@map("user_memberships")
}

/// 支付流水表
model PaymentLog {
  id           String   @id @default(uuid())
  orderNo      String
  notifyId     String?
  amount       Int                                      // 整数分
  payStatus    String   @default("pending")
  channel      String   @default("wechat")
  rawData      Json?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([orderNo])
  @@index([payStatus])
  @@index([createdAt])
  @@map("payment_logs")
}

/// 权益配置表
model MembershipRights {
  id          String   @id @default(uuid())
  level       Int      @unique
  levelName   String
  features    Json     @default("[]")
  quotas      Json     @default("{}")
  dailyLimits Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("membership_rights")
}


/// 邀请关系表（Stage 10 阶段4 增量）
model ReferralLink {
  id          String   @id @default(uuid())
  referrerId  String                                    // 邀请人用户ID
  refereeId   String   @unique                          // 被邀请人用户ID（唯一，不可重复绑定）
  inviteCode  String?                                   // 邀请码
  source      String   @default("share_link")           // 来源渠道
  boundAt     DateTime @default(now())

  referrer    User?    @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  referee     User?    @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([inviteCode])
  @@map("referral_links")
}

// ===================== v1.1.0: AI 自适应句型练习系统 =====================

model PracticeConfig {
  id            String   @id @default(uuid())
  userId        String   @unique
  durationMinutes Int    @default(10)  // 用户设置的每日练习时长（分钟）
  currentDay    Int      @default(1)   // 30天计划当前天数
  streakDays    Int      @default(0)   // 连续打卡天数
  lastPracticeAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("practice_configs")
}

model SentencePracticeRecord {
  id            String   @id @default(uuid())
  userId        String
  sessionDate   DateTime @default(now())
  level         String   // beginner / intermediate / advanced
  language      String   // en / ja / ko / ...
  languageType  String   @default("system") // system / custom
  totalCount    Int      // 本次练习句型总数
  correctCount  Int      // 答对数量
  accuracy      Decimal  @default(0)        // 正确率 0-1
  durationMinutes Int
  pattern       Json     // 生成配置快照 { basicCount, consolidationCount, improvementCount }
  weakPoints    Json     @default("[]")      // 薄弱点列表 ["tense", "particle"...]
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, sessionDate])
  @@map("sentence_practice_records")
}

model WrongQuestion {
  id            String   @id @default(uuid())
  userId        String
  recordId      String?  // 关联 SentencePracticeRecord
  questionType  String   // listen_select / fill_blank / shadow_speak
  sentence      String   // 原始句子
  meaning       String?  // 中文翻译
  grammarPoint  String?  // 语法点
  userAnswer    String?  // 用户答案
  correctAnswer String?  // 正确答案
  reviewedAt    DateTime? // 复习时间
  reviewedCorrect Boolean @default(false)
  reviewCount   Int      @default(0)  // 复习次数
  language      String
  createdAt     DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([userId, createdAt])
  @@map("wrong_questions")
}

// ===================== v1.1.0: 自定义语言差异化计费 =====================

model CustomLanguageQuota {
  id            String   @id @default(uuid())
  userId        String   @unique
  totalQuota    Int      @default(50)   // 当月总配额（免费会员50次/月，高级会员无限）
  usedQuota     Int      @default(0)
  resetAt       DateTime                // 配额重置时间（下月1日）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("custom_language_quotas")
}

model LanguageBillingLog {
  id            String   @id @default(uuid())
  userId        String
  language      String   // 自定义语言代码
  serviceType   String   // vocab / grammar / sentence / reading / translate / chat / evaluate / listening
  costAmount    Int      @default(1)   // 消耗配额数
  quotaRemaining Int     // 剩余配额
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@map("language_billing_logs")
}

// ==================== 词汇学习全链路（Vocabulary v1）====================

/// 词库：系统级共享词汇表（非用户数据）
model VocabularyWord {
  id       String  @id @default(uuid())
  language String // ja / en / ko / zh / fr / de / es
  level    String // beginner / intermediate / advanced
  word     String // 单词 / 词组
  phonetic String? // 音标 / 假名
  meaning  String // 正确释义（中文）
  example  String? // 例句
  exampleMeaning String? // 例句释义
  tags     String? // 分类标签，逗号分隔
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progresses VocabularyProgress[]

  @@unique([language, word])
  @@index([language, level, isActive])
  @@map("vocabulary_words")
}

/// 用户单词掌握度（每人每词一条）
model VocabularyProgress {
  id     String @id @default(uuid())
  userId String
  wordId String
  word   VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  language     String
  correctCount Int      @default(0)
  wrongCount   Int      @default(0)
  mastered     Boolean  @default(false) // 累计答对 >=2 次判定掌握
  lastSeenAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([userId, language])
  @@index([userId, mastered])
  @@map("vocabulary_progress")
}

/// 用户每日学习统计（时长/经验，落库真实数据）
model VocabularyDailyStat {
  id       String   @id @default(uuid())
  userId   String
  language String
  statDate DateTime @db.Date

  studySeconds Int @default(0)
  answered     Int @default(0)
  correct      Int @default(0)
  xpGained     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, language, statDate])
  @@index([userId, statDate])
  @@map("vocabulary_daily_stats")
}

// ============================================================
// P1-M语音模块：语音用量日志（2026-08-04 增量追加）
// 纯追加，不修改已有模型。所有 TTS/ASR 调用落库，支持按用户/按天统计。
// ============================================================
model VoiceUsageLog {
  id        String   @id @default(uuid())
  userId    String
  scene     String   @default("vocab")
  type      String   @default("tts")
  lang      String   @default("en")
  provider  String   @default("native")
  chars     Int      @default(0)
  duration  Int      @default(0)
  success   Boolean  @default(true)
  errCode   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([scene])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("voice_usage_logs")
}

// ============================================================
// v3.2.0 社交板块升级：站外资讯聚合模块（纯增量，不修改已有模型）
// 对齐《双宪法v3.2.0》《架构蓝图v3.2.0》社交域资讯聚合条款
// 合规优先：仅存储标题+摘要+来源+原文链接，绝不全文转载
// ============================================================

/// news_source — 资讯来源管理（后台可增删，白名单机制）
model NewsSource {
  id          String   @id @default(uuid())
  name        String   @unique // 来源名称
  url         String   @unique // 来源主页URL
  feedUrl     String?  // RSS/Atom订阅地址（如支持）
  category    String   @default("general") // learning_method|study_abroad|exam_policy|culture|hotspot|general
  language    String   @default("zh-CN") // 资讯语种
  isActive    Boolean  @default(true) // 是否启用抓取
  isWhitelist Boolean  @default(false) // 白名单来源（允许展示官方广告）
  isBlacklist Boolean  @default(false) // 黑名单来源（拉黑后不再抓取）
  crawlCount  Int      @default(0) // 累计抓取次数
  lastCrawlAt DateTime? // 最后抓取时间
  dailyLimit  Int      @default(10) // 每日抓取上限（单来源）
  metadata    Json?    // 扩展配置（选择器、编码等）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles NewsArticle[]

  @@index([isActive])
  @@index([isWhitelist])
  @@index([isBlacklist])
  @@index([category])
  @@map("news_sources")
}

/// news_article — 资讯文章（仅标题+摘要+来源+原文链接，绝不全文转载）
model NewsArticle {
  id          String   @id @default(uuid())
  sourceId    String
  source      NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  title       String   // 文章标题
  summary     String   // 摘要（100字以内，由系统截取或AI生成）
  originalUrl String   @unique // 原文链接（跳转至源站）
  author      String?  // 原作者/来源标注

  category    String   @default("general") // learning_method|study_abroad|exam_policy|culture|hotspot|general
  language    String   @default("zh-CN")
  tags        String[] @default([]) // AI/规则打标

  // 合规与审核状态
  status      String   @default("pending") // pending|approved|rejected|offline
  isAd        Boolean  @default(false) // 是否被识别为广告内容
  isOfficialAd Boolean @default(false) // 是否为白名单官方广告
  adReason    String?  // 广告识别原因

  // AI处理记录
  aiProcessed Boolean  @default(false) // 是否经过AI深度处理
  aiCallCount Int      @default(0) // AI调用次数（单条限制1次）

  // 展示控制
  isPinned    Boolean  @default(false) // 是否置顶
  viewCount   Int      @default(0) // 浏览次数
  reportCount Int      @default(0) // 举报次数

  // 内容哈希（去重）
  contentHash String?  @unique // 标题+URL的MD5，用于增量去重

  publishedAt DateTime? // 原文发布时间
  crawledAt   DateTime  @default(now()) // 抓取时间
  reviewedAt  DateTime? // 审核时间
  reviewedBy  String?   // 审核人

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports    NewsReport[]
  auditLogs  NewsAuditLog[]

  @@index([sourceId])
  @@index([status])
  @@index([category])
  @@index([isAd])
  @@index([isPinned])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("news_articles")
}

/// news_report — 用户举报记录
model NewsReport {
  id        String   @id @default(uuid())
  articleId String
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reporterId String
  reporter  User     @relation("NewsReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reason    String   // violation|ad|infringement|other
  detail    String?  // 举报详情
  status    String   @default("pending") // pending|resolved|dismissed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([reporterId])
  @@index([status])
  @@map("news_reports")
}

/// news_audit_log — 资讯管理审计日志（审核、置顶、下架、广告投放等操作留痕）
model NewsAuditLog {
  id          String   @id @default(uuid())
  articleId   String?
  article     NewsArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  operatorId  String
  operator    User     @relation("NewsAuditOperator", fields: [operatorId], references: [id], onDelete: Cascade)

  action      String   // approve|reject|offline|pin|unpin|ad_place|ad_remove|source_block|source_unblock
  detail      Json?    // 操作详情
  beforeState String?  // 操作前状态
  afterState  String?  // 操作后状态

  createdAt   DateTime @default(now())

  @@index([articleId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
  @@map("news_audit_logs")
}

