  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  @@index([userId])
}

model TranslationPackageOrder {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderNo      String   @unique
  packageType  String   // pay_1h|pay_10h|pay_30h|pay_100h|daily|weekly|monthly
  minutesTotal Int
  minutesUsed  Int      @default(0)
  priceCny     Float
  expiresAt    DateTime
  status       String   @default("paid") // paid|refunded|expired
  paidAt       DateTime?
  abnormal         Boolean  @default(false)
  abnormalNote     String?
  abnormalMarkedAt DateTime?
  abnormalMarkedBy String?
  createdAt    DateTime @default(now())
  @@index([userId])
}

model TranslationBillingLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene           String   // photo(免费)|scan|conversation|trial
  consumedSec     Int
  source          String   // trial|subscription|paid_package
  orderId         String?
  requestId       String?  // DEF-P3-01 幂等键（body.requestId / X-Request-Id 头）
  balanceAfterSec Int
