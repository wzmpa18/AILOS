// ==================== Stage 9 M5: Social Dynamics (动态模块) — 纯增量模型 ====================

// social_timeline — 社群动态时间线（发布/内容/互动计数）
model SocialTimeline {
  id           String   @id @default(uuid())
  actorId      String
  actor        User     @relation("SocialTimelineActor", fields: [actorId], references: [id], onDelete: Cascade)
  type         String   @default("post") // post|share|achievement
  content      String
  metadata     String?  // JSON: { images[], tags[], etc. }
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  createdAt    DateTime @default(now())

  // v3.2.0 增量字段：社交板块升级（纯新增，不修改原有字段）
