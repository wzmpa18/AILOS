// ============================================================
// AILOS Prisma Schema — Express Backend (MVP)
// 数据库: MySQL 8.0
// 版本: v1.0.0
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/config/generated"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户系统 (user_db)
// ============================================================

model User {
  id                  BigInt    @id @default(autoincrement())
  uniqueId            String    @unique @default(uuid())
  phone               String?   @unique
  email               String?   @unique
  passwordHash        String?
  wechatOpenId        String?   @unique
  wechatUnionId       String?
  nickname            String?
  avatar              String?
  membershipLevel     String    @default("free")
  isActive            Boolean   @default(true)
  isVerified          Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  xp                  Int       @default(0)
  level               Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  identity          UserIdentity?
  workspace         Workspace[]
  languagePreference UserLanguagePreference?
  learningLanguages UserLearningLanguage[]
  sessions          Session[]
  quotas            UserQuota[]
  checkins          Checkin[]
  learningEvents    LearningEvent[]
  userWords         UserWord[]
}

model UserIdentity {
  id                 Int        @id @default(autoincrement())
  userId             BigInt     @unique
  identityType       String     @default("personal")
  metadata           Json?
  defaultWorkspaceId Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user              User       @relation(fields: [userId], references: [id])
}

model Workspace {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("personal")
  ownerId   BigInt
  isDefault Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User     @relation(fields: [ownerId], references: [id])
}

model UserLanguagePreference {
  id                        Int      @id @default(autoincrement())
  userId                    BigInt   @unique
  nativeLanguage            String   @default("zh-CN")
  interfaceLanguage         String   @default("zh-CN")
  defaultExplanationLanguage String  @default("zh-CN")
  fallbackLanguage          String   @default("zh-CN")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user                      User     @relation(fields: [userId], references: [id])
}

model UserLearningLanguage {
  id           Int      @id @default(autoincrement())
  userId       BigInt
  languageCode String
  level        String   @default("A1")
  priority     Int      @default(1)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, languageCode])
}

model GuestSession {
  id              String    @id @default(uuid())
  deviceId        String
  localProgress   Json?
  convertedUserId BigInt?
  convertedAt     DateTime?
  lastActiveAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       BigInt
  token        String
  refreshToken String
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
}

model SmsVerification {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  type      String   @default("login")
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============================================================
// 签到 & 额度
// ============================================================

model Checkin {
  id          Int      @id @default(autoincrement())
  userId      BigInt
  checkinDate DateTime
  streak      Int      @default(0)
  xpAwarded   Int      @default(0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, checkinDate])
}

model UserQuota {
  id               Int      @id @default(autoincrement())
  userId           BigInt   @unique
  dailyConversation Int     @default(0)
  dailyCorrection  Int      @default(0)
  maxConversation  Int      @default(5)
  maxCorrection    Int      @default(3)
  resetAt          DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id])
}

// ============================================================
// 学习系统
// ============================================================

model LearningEvent {
  id        Int      @id @default(autoincrement())
  userId    BigInt
  eventType String
  duration  Int      @default(0)
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model UserWord {
  id         Int      @id @default(autoincrement())
  userId     BigInt
  word       String
  language   String
  mastery    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, word, language])
}

// ============================================================
// 学习内容体系 (Module 02)
// ============================================================

model Language {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  nameEn      String
  nameLocal   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses     Course[]
}

model Course {
  id           Int      @id @default(autoincrement())
  languageId   Int
  title        String
  description  String?
  level        String   @default("A1")
  sortOrder    Int      @default(0)
  iconUrl      String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  language     Language @relation(fields: [languageId], references: [id])
  units        CourseUnit[]
}

model CourseUnit {
  id          Int      @id @default(autoincrement())
  courseId    Int
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id])
  items       CourseItem[]
}

model CourseItem {
  id          Int      @id @default(autoincrement())
  unitId      Int
  itemType    String
  title       String
  content     Json
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit        CourseUnit @relation(fields: [unitId], references: [id])
  progress    UserCourseProgress[]
}

model UserCourseProgress {
  id           Int      @id @default(autoincrement())
  userId       BigInt
  itemId       Int
  status       String   @default("not_started")
  score        Int?
  attempts     Int      @default(0)
  lastAttemptAt DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  item         CourseItem @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

// ============================================================
// AI 对话引擎 (Module 03)
// ============================================================

model AIConversation {
  id        Int         @id @default(autoincrement())
  userId    BigInt
  title     String
  language  String      @default("auto")
  level     String      @default("A1")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages  AIMessage[]
}

model AIMessage {
  id             Int            @id @default(autoincrement())
  conversationId Int
  role           String
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id])
}

model AITranslation {
  id             Int      @id @default(autoincrement())
  userId         BigInt
  sourceText     String   @db.Text
  translatedText String   @db.Text
  sourceLang     String
  targetLang     String
  createdAt      DateTime @default(now())
}

model AICorrection {
  id            Int      @id @default(autoincrement())
  userId        BigInt
  originalText  String   @db.Text
  correctedText String   @db.Text
  errors        Json
  tips          String   @db.Text
  language      String   @default("auto")
  createdAt     DateTime @default(now())
}

// ============================================================
// 学习闭环 — SRS 间隔重复系统 (Module 04)
// ============================================================

model SRSDeck {
  id          Int       @id @default(autoincrement())
  userId      BigInt
  title       String
  language    String
  description String?
  cardCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cards       SRSCard[]
}

model SRSCard {
  id           Int        @id @default(autoincrement())
  deckId       Int
  front        String
  back         String
  notes        String?
  easeFactor   Float      @default(2.5)
  interval     Int        @default(0)
  repetitions  Int        @default(0)
  nextReviewAt DateTime   @default(now())
  lastReviewAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  deck         SRSDeck    @relation(fields: [deckId], references: [id])
  reviews      SRSReview[]
}

model SRSReview {
  id        Int      @id @default(autoincrement())
  cardId    Int
  userId    BigInt
  quality   Int
  elapsedMs Int?
  reviewedAt DateTime @default(now())

  card      SRSCard  @relation(fields: [cardId], references: [id])
}

// ============================================================
// 学习报告 (Module 04)
// ============================================================

model LearningReport {
  id              Int      @id @default(autoincrement())
  userId          BigInt
  reportDate      DateTime
  studyMinutes    Int      @default(0)
  wordsLearned    Int      @default(0)
  wordsReviewed   Int      @default(0)
  xpEarned        Int      @default(0)
  conversationsCount Int  @default(0)
  correctionsCount  Int   @default(0)
  streakDays      Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([userId, reportDate])
}

// ============================================================
// 会员+体力+返利 (Module 05)
// ============================================================

model Membership {
  id            Int      @id @default(autoincrement())
  userId        BigInt   @unique
  level         String   @default("free")
  startedAt     DateTime @default(now())
  expiresAt     DateTime?
  autoRenew     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MembershipTransaction {
  id            Int      @id @default(autoincrement())
  userId        BigInt
  type          String
  level         String
  amount        Float    @default(0)
  currency      String   @default("CNY")
  status        String   @default("completed")
  paymentMethod String?
  createdAt     DateTime @default(now())
}

model Stamina {
  id            Int      @id @default(autoincrement())
  userId        BigInt   @unique
  current       Int      @default(100)
  max           Int      @default(100)
  lastRefillAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StaminaTransaction {
  id          Int      @id @default(autoincrement())
  userId      BigInt
  amount      Int
  reason      String
  reference   String?
  createdAt   DateTime @default(now())
}

model InviteCode {
  id          Int       @id @default(autoincrement())
  userId      BigInt    @unique
  code        String    @unique
  usageCount  Int       @default(0)
  maxUses     Int       @default(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  records     InviteRecord[]
}

model InviteRecord {
  id            Int      @id @default(autoincrement())
  inviteCodeId  Int
  inviterUserId BigInt
  inviteeUserId BigInt
  status        String   @default("registered")
  rewardedAt    DateTime?
  createdAt     DateTime @default(now())

  inviteCode    InviteCode @relation(fields: [inviteCodeId], references: [id])
}

model Commission {
  id          Int      @id @default(autoincrement())
  userId      BigInt
  amount      Float    @default(0)
  currency    String   @default("CNY")
  status      String   @default("pending")
  source      String
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}