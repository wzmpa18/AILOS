// ==================== Stage 9 M5: Community Core Models (社群核心模型) — 纯增量 ====================

// friend_setting — 好友关系与设置
model FriendSetting {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("FriendSettingOwner", fields: [userId], references: [id], onDelete: Cascade)
  friendId    String
  friend      User     @relation("FriendSettingTarget", fields: [friendId], references: [id], onDelete: Cascade)
  remarkName  String?  // 备注名
  tags        String[] // 标签列表
  isMuted     Boolean  @default(false)
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([isBlocked])

  @@map("friend_settings")
}

// friend_blacklist — 拉黑屏蔽关系（v1.1.0 宪法 3.2 增量新增）
//   单向屏蔽：operator 拉黑 target 后，target 不能向 operator 发消息/看动态/发申请/评论互动。
//   增量兼容：仅新增模型，不改动任何已有字段与表。
model FriendBlacklist {
  id         String   @id @default(uuid())
  operatorId String   // 拉黑发起方
  targetId   String   // 被拉黑方
  createdAt  DateTime @default(now())

  @@unique([operatorId, targetId]) // 联合唯一，重复拉黑幂等
  @@index([operatorId])
  @@index([targetId])

  @@map("friend_blacklist")
}

// group — 群组
model Group {
  id           String   @id @default(uuid())
  name         String
  description  String?
  avatarUrl    String?
  ownerId      String
  owner        User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  maxMembers   Int      @default(50)
  createdVia   String   @default("manual") // manual, system
  announcement String?
  muteAll      Boolean  @default(false)
  status       String   @default("active") // active, archived
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members GroupMember[]

  @@index([ownerId])
  @@index([createdAt])

  @@map("groups")
}

// group_member — 群成员
model GroupMember {
  id            String   @id @default(uuid())
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String   @default("member") // owner, admin, member
  groupNickname String?
  mute          Boolean  @default(false)
  joinTime      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([role])

  @@map("group_members")
}

// conversation — 会话（单聊/群聊）
model Conversation {
  id             String    @id @default(uuid())
  type           String    @default("single") // single, group
  targetId       String?
  participants   String[]  // userIds
  lastMsgId      String?
  lastMsgPreview String?
  lastMsgTime    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type])
  @@index([lastMsgTime])

  @@map("conversations")
}

// message — 消息
model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  msgType        String   @default("text") // text, image, file
  content        String
  isRead         Boolean  @default(false)
  isRevoked      Boolean  @default(false)
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])

  @@map("messages")
}

model ContentAuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  content       String
  scene         String   @default("post")
  endpoint      String?
  ip            String?
  words         Json?
  level         String?  @default("normal") // normal | severe
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([scene])
  @@index([createdAt])
  @@index([level])

  @@map("content_audit_logs")
}


