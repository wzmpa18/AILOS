// ============================================
// AILOS Prisma Schema v2.0.0
// 软件架构蓝图 v2.0.0 强制执行
// 七库分库隔离，每个模块仅访问自身业务库
// ============================================

generator client {
  provider = "prisma-client-js"
}

// ============================================
// 多数据源 — 七库分离
// 生产环境按模块注入对应 DATABASE_URL
// ============================================

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户库 (user_db)
// ============================================
model User {
  id            BigInt    @id @default(autoincrement()) @map("user_id")
  username      String    @unique @db.VarChar(64)
  email         String?   @unique @db.VarChar(128)
  phone         String?   @db.VarChar(32)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(512)
  nickname      String?   @db.VarChar(64)
  membership    MembershipLevel @default(free)
  registeredAt  DateTime  @default(now()) @map("registered_at")
  lastLoginAt   DateTime? @map("last_login_at")
  status        UserStatus @default(active)
  deletedAt     DateTime? @map("deleted_at")

  quotas        UserQuota[]
  dailyCheckins DailyCheckin[]

  @@map("users")
}

model UserQuota {
  id          BigInt   @id @default(autoincrement()) @map("quota_id")
  userId      BigInt   @map("user_id")
  date        DateTime @db.Date
  dailyUsed   Int      @default(0) @map("daily_used")
  dailyLimit  Int      @default(50) @map("daily_limit")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("user_quotas")
}

model DailyCheckin {
  id          BigInt   @id @default(autoincrement()) @map("checkin_id")
  userId      BigInt   @map("user_id")
  date        DateTime @db.Date
  streakDays  Int      @default(0) @map("streak_days")
  points      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("daily_checkins")
}

enum UserStatus {
  active
  frozen
  deleted
}

enum MembershipLevel {
  free
  member
  premium
}

// ============================================
// 学习库 (learning_db)
// ============================================
model LearnerProfile {
  id              BigInt   @id @default(autoincrement()) @map("profile_id")
  userId          BigInt   @unique @map("user_id")
  totalStudyTime  Int      @default(0) @map("total_study_time")
  totalExercises  Int      @default(0) @map("total_exercises")
  avgScore        Float    @default(0) @map("avg_score")
  currentLevel    String   @default("beginner") @db.VarChar(32) @map("current_level")
  strengths       Json     @default("[]")
  weaknesses      Json     @default("[]")
  updatedAt       DateTime @updatedAt @map("updated_at")

  domainProfiles  DomainLearnerProfile[]
  learningPaths   LearningPath[]
  knowledgeTraces KnowledgeTrace[]

  @@map("learner_profiles")
}

model DomainLearnerProfile {
  id              BigInt   @id @default(autoincrement()) @map("domain_profile_id")
  profileId       BigInt   @map("profile_id")
  domain          String   @db.VarChar(32)
  level           String   @default("beginner") @db.VarChar(32)
  studyTime       Int      @default(0) @map("study_time")
  exercises       Int      @default(0)
  avgScore        Float    @default(0) @map("avg_score")
  lastActivityAt  DateTime? @map("last_activity_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile LearnerProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, domain])
  @@map("domain_learner_profiles")
}

model LearningPath {
  id          BigInt   @id @default(autoincrement()) @map("path_id")
  profileId   BigInt   @map("profile_id")
  domain      String   @db.VarChar(32)
  nodes       Json
  currentNode Int      @default(0) @map("current_node")
  status      String   @default("in_progress") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile LearnerProfile @relation(fields: [profileId], references: [id])

  @@map("learning_paths")
}

model KnowledgeTrace {
  id          BigInt   @id @default(autoincrement()) @map("trace_id")
  profileId   BigInt   @map("profile_id")
  skillId     String   @map("skill_id") @db.VarChar(128)
  mastery     Float    @default(0)
  attempts    Int      @default(0)
  corrects    Int      @default(0)
  lastTestedAt DateTime? @map("last_tested_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile LearnerProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, skillId])
  @@map("knowledge_traces")
}

model LearningActivity {
  id          BigInt   @id @default(autoincrement()) @map("activity_id")
  profileId   BigInt   @map("profile_id")
  domain      String   @db.VarChar(32)
  activityType String  @map("activity_type") @db.VarChar(32)
  duration    Int      @default(0)
  score       Float?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("learning_activities")
}

// ============================================
// 陪伴库 (companion_db)
// ============================================
model CompanionProfile {
  id              BigInt   @id @default(autoincrement()) @map("companion_id")
  userId          BigInt   @unique @map("user_id")
  personaName     String   @default("小言") @map("persona_name") @db.VarChar(64)
  personalityJson Json     @default("{}") @map("personality_json")
  growthLevel     Int      @default(1) @map("growth_level")
  growthExp       Int      @default(0) @map("growth_exp")
  intimacy        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memories        CompanionMemory[]
  emotionLogs     EmotionLog[]
  chatSessions    ChatSession[]

  @@map("companion_profiles")
}

model CompanionMemory {
  id           BigInt   @id @default(autoincrement()) @map("memory_id")
  companionId  BigInt   @map("companion_id")
  keywords     Json     @default("[]")
  content      String   @db.Text
  importance   Int      @default(1)
  recalledAt   DateTime? @map("recalled_at")
  createdAt    DateTime @default(now()) @map("created_at")

  companion CompanionProfile @relation(fields: [companionId], references: [id])

  @@map("companion_memories")
}

model EmotionLog {
  id          BigInt   @id @default(autoincrement()) @map("emotion_id")
  companionId BigInt   @map("companion_id")
  emotion     String   @db.VarChar(32)
  intensity   Float    @default(0.5)
  trigger     String?  @db.VarChar(256)
  createdAt   DateTime @default(now()) @map("created_at")

  companion CompanionProfile @relation(fields: [companionId], references: [id])

  @@map("emotion_logs")
}

model ChatSession {
  id          BigInt   @id @default(autoincrement()) @map("session_id")
  companionId BigInt   @map("companion_id")
  messages    Json
  startedAt   DateTime @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")

  companion CompanionProfile @relation(fields: [companionId], references: [id])

  @@map("chat_sessions")
}

model GrowthEvent {
  id          BigInt   @id @default(autoincrement()) @map("growth_id")
  companionId BigInt   @map("companion_id")
  eventType   String   @map("event_type") @db.VarChar(32)
  expGained   Int      @default(0) @map("exp_gained")
  newLevel    Int?     @map("new_level")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("growth_events")
}

// ============================================
// 知识库 (knowledge_db)
// ============================================
model KnowledgeAsset {
  id            BigInt    @id @default(autoincrement()) @map("asset_id")
  domain        String    @db.VarChar(32)
  assetType     String    @map("asset_type") @db.VarChar(32)
  title         String    @db.VarChar(256)
  content       String    @db.Text
  tags          Json      @default("[]")
  difficulty    Int       @default(1)
  qualityScore  Float     @default(0) @map("quality_score")
  status        AssetStatus @default(pending)
  version       Int       @default(1)
  submittedBy   BigInt?   @map("submitted_by")
  reviewedBy    BigInt?   @map("reviewed_by")
  reviewNote    String?   @map("review_note") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  feedbacks Feedback[]

  @@map("knowledge_assets")
}

model Feedback {
  id          BigInt   @id @default(autoincrement()) @map("feedback_id")
  assetId     BigInt?  @map("asset_id")
  userId      BigInt   @map("user_id")
  category    String   @db.VarChar(32)
  content     String   @db.Text
  aiSuggestion String? @map("ai_suggestion") @db.Text
  status      FeedbackStatus @default(pending)
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  asset KnowledgeAsset? @relation(fields: [assetId], references: [id])

  @@map("feedbacks")
}

model AssetVersion {
  id          BigInt   @id @default(autoincrement()) @map("version_id")
  assetId     BigInt   @map("asset_id")
  version     Int
  content     String   @db.Text
  changelog   String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("asset_versions")
}

enum AssetStatus {
  pending
  approved
  rejected
  deprecated
}

enum FeedbackStatus {
  pending
  reviewing
  resolved
  rejected
}

// ============================================
// 社交库 (social_db)
// ============================================
model SocialRelation {
  id          BigInt   @id @default(autoincrement()) @map("relation_id")
  userId      BigInt   @map("user_id")
  targetId    BigInt   @map("target_id")
  relationType String  @map("relation_type") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, targetId, relationType])
  @@map("social_relations")
}

model Post {
  id        BigInt    @id @default(autoincrement()) @map("post_id")
  userId    BigInt    @map("user_id")
  content   String    @db.Text
  mediaUrls Json      @default("[]") @map("media_urls")
  likes     Int       @default(0)
  comments  Int       @default(0)
  status    PostStatus @default(published)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  postComments Comment[]
  postLikes    Like[]

  @@map("posts")
}

model Comment {
  id        BigInt   @id @default(autoincrement()) @map("comment_id")
  postId    BigInt   @map("post_id")
  userId    BigInt   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id])

  @@map("comments")
}

model Like {
  id        BigInt   @id @default(autoincrement()) @map("like_id")
  postId    BigInt   @map("post_id")
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id])

  @@unique([postId, userId])
  @@map("likes")
}

model Leaderboard {
  id          BigInt   @id @default(autoincrement()) @map("leaderboard_id")
  userId      BigInt   @map("user_id")
  scope       String   @db.VarChar(16)
  score       Int      @default(0)
  rank        Int      @default(0)
  period      String   @db.VarChar(16)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, scope, period])
  @@map("leaderboards")
}

enum PostStatus {
  published
  hidden
  deleted
}

// ============================================
// 营销库 (marketing_db)
// ============================================
model InviteCode {
  id          BigInt   @id @default(autoincrement()) @map("invite_id")
  code        String   @unique @db.VarChar(16)
  creatorId   BigInt   @map("creator_id")
  usedCount   Int      @default(0) @map("used_count")
  maxUses     Int      @default(100) @map("max_uses")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  inviteRecords InviteRecord[]

  @@map("invite_codes")
}

model InviteRecord {
  id          BigInt   @id @default(autoincrement()) @map("record_id")
  inviteId    BigInt   @map("invite_id")
  invitedUserId BigInt @map("invited_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  inviteCode InviteCode @relation(fields: [inviteId], references: [id])

  @@unique([invitedUserId])
  @@map("invite_records")
}

model Commission {
  id          BigInt   @id @default(autoincrement()) @map("commission_id")
  userId      BigInt   @map("user_id")
  level       Int
  amount      Float
  sourceUserId BigInt  @map("source_user_id")
  status      CommissionStatus @default(pending)
  createdAt   DateTime @default(now()) @map("created_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  @@map("commissions")
}

model Withdrawal {
  id          BigInt   @id @default(autoincrement()) @map("withdrawal_id")
  userId      BigInt   @map("user_id")
  amount      Float
  method      String   @db.VarChar(32)
  account     String   @db.VarChar(128)
  status      WithdrawalStatus @default(pending)
  createdAt   DateTime @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@map("withdrawals")
}

enum CommissionStatus {
  pending
  settled
  withdrawn
}

enum WithdrawalStatus {
  pending
  approved
  rejected
  completed
}

// ============================================
// 系统库 (system_db)
// ============================================
model SystemConfig {
  id          BigInt   @id @default(autoincrement()) @map("config_id")
  configKey   String   @unique @map("config_key") @db.VarChar(128)
  configValue Json     @map("config_value")
  description String?  @db.VarChar(512)
  updatedBy   BigInt?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement()) @map("audit_id")
  userId      BigInt?  @map("user_id")
  action      String   @db.VarChar(64)
  resource    String   @db.VarChar(128)
  resourceId  String?  @map("resource_id") @db.VarChar(64)
  detail      Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model ApiKey {
  id          BigInt   @id @default(autoincrement()) @map("api_key_id")
  userId      BigInt   @map("user_id")
  keyHash     String   @map("key_hash") @db.VarChar(255)
  name        String   @db.VarChar(128)
  permissions Json     @default("[]")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  status      ApiKeyStatus @default(active)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("api_keys")
}

model PluginRegistry {
  id          BigInt   @id @default(autoincrement()) @map("plugin_id")
  pluginName  String   @unique @map("plugin_name") @db.VarChar(128)
  version     String   @db.VarChar(32)
  manifest    Json
  status      PluginStatus @default(registered)
  grayscaleRate Float   @default(0) @map("grayscale_rate")
  registeredAt DateTime @default(now()) @map("registered_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("plugin_registry")
}

model CostRecord {
  id          BigInt   @id @default(autoincrement()) @map("cost_id")
  callId      String   @unique @map("call_id") @db.VarChar(64)
  module      String   @db.VarChar(64)
  userId      BigInt?  @map("user_id")
  modelName   String   @map("model_name") @db.VarChar(64)
  tokensIn    Int      @default(0) @map("tokens_in")
  tokensOut   Int      @default(0) @map("tokens_out")
  cost        Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cost_records")
}

enum ApiKeyStatus {
  active
  revoked
  expired
}

enum PluginStatus {
  registered
  enabled
  disabled
  uninstalled
}
